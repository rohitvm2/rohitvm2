<DashboardScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        spacing: 20

        Label:
            text: f"Welcome {app.current_user}"

        Label:
            text: "Mock Test App"
            font_size: 28
            bold: True
            color: (1,1,1,1)

        Button:
            text: "Profile"
            size_hint_y: None
            height: 50
            background_color: (0.2,0.6,1,1)
            on_press:
                root.manager.get_screen("profile").user = root.user
                root.manager.current = "profile"

        Button:
            text: "Start Test"
            size_hint_y: None
            height: 50
            background_color: (0.2,0.6,1,1)
            on_press: app.root.current = "test"

        Button:
            text: "View Results"
            size_hint_y: None
            height: 50
            on_press: app.root.current = "my_results"

        Button:
            text: "Leaderboard"
            size_hint_y: None
            height: 50
            on_press: app.root.current = "leaderboard"

        Button:
            text: "Logout"
            size_hint_y: None
            height: 50
            background_color: (0.2,0.6,1,1)
            on_press: app.root.current = "login"