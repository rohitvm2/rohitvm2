<InstructionScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [20, 40, 20, 40]
        spacing: 20

        Label:
            text: "Test Instructions"
            font_size: '28sp'
            bold: True
            size_hint_y: None
            height: 60
            color: (0.2, 0.6, 1, 1)  # Light Blue Title

        # Instructions Box
        Widget:
            size_hint_y: None
            height: 2
            canvas:
                Color:
                    rgba: (0.3, 0.3, 0.3, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

        Label:
            text: root.instructions_text
            font_size: '18sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            line_height: 1.5

        Widget: # Spacer
            size_hint_y: 0.2

        # Buttons
        BoxLayout:
            orientation: 'vertical'
            spacing: 15
            size_hint_y: None
            height: 120

            Button:
                text: "START TEST"
                size_hint_x: 0.8
                pos_hint: {'center_x': 0.5}
                background_normal: ''
                background_color: (0.1, 0.8, 0.4, 1) # Green Action Button
                bold: True
                on_release: root.start_test()

            Button:
                text: "Back to Dashboard"
                size_hint_x: 0.8
                pos_hint: {'center_x': 0.5}
                background_normal: ''
                background_color: (0.4, 0.4, 0.4, 1) # Gray Neutral Button
                on_release: root.go_back()