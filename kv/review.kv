<ReviewScreen>:
    canvas.before:
        Color:
            rgba: (0.1, 0.1, 0.1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [20, 40, 20, 20]
        spacing: 15

        Label:
            text: "TEST REVIEW"
            font_size: '26sp'
            bold: True
            color: (0.2, 0.6, 1, 1)
            size_hint_y: None
            height: 60

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: review_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 15
                padding: [0, 10]

        Button:
            text: "FINISH REVIEW"
            size_hint_y: None
            height: 50
            background_normal: ''
            background_color: (0, 0, 0, 0)
            on_release: app.root.current = "result"
            canvas.before:
                Color:
                    rgba: (0.2, 0.6, 1, 1) if self.state == 'normal' else (0.1, 0.4, 0.8, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10,]