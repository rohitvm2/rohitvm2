<ProfileScreen>:
    name: "profile"

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 15

        Label:
            text: "Profile"
            font_size: 28

        BoxLayout:
            orientation: "vertical"

            Label:
                text: "Username"
            Label:
                id: username
                text: ""

        BoxLayout:
            orientation: "vertical"

            Label:
                text: "Email"
            Label:
                id: email
                text: ""

        Button:
            text: "Logout"
            height: 50
            on_press: app.root.current = "login"