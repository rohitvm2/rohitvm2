<AdminScreen>:
    ScrollView:
        BoxLayout:
            orientation: "vertical"
            padding: 20
            spacing: 10
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "Admin Panel"
                font_size: 24

            TextInput:
                id: q
                hint_text: "Question"
                size_hint_y: None
                height: 50

            TextInput:
                id: o1
                hint_text: "Option 1"
                size_hint_y: None
                height: 50

            TextInput:
                id: o2
                hint_text: "Option 2"
                size_hint_y: None
                height: 50

            TextInput:
                id: o3
                hint_text: "Option 3"
                size_hint_y: None
                height: 50

            TextInput:
                id: o4
                hint_text: "Option 4"
                size_hint_y: None
                height: 50

            TextInput:
                id: ans
                hint_text: "Correct Answer"
                size_hint_y: None
                height: 50

            Button:
                text: "Add Question"
                size_hint_y: None
                height: 50
                background_color: (0.2, 0.6, 1, 1)
                on_press: root.add_question()

            Label:
                id: msg
                text: ""

            Button:
                text: "Show Questions"
                size_hint_y: None
                height: 40
                on_press: root.show_questions()

            ScrollView:
                size_hint_y: None
                height: 200

                Label:
                    id: display_area
                    text: ""
                    size_hint_y: None
                    height: self.texture_size[1]

            Button:
                text: "Logout"
                size_hint_y: None
                height: 50
                on_press: app.root.current = "login"