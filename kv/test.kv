<TestScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 20

        Label:
            id: qno
            text: "Question 1/5"
            size_hint_y: None
            height: 30
            color: (1,1,1,1)

        Label:
            id: feedback
            text: ""
            color: (1,1,1,1)

        Label:
            id: score_label
            text: "Score: 0"
            size_hint_y: None
            height: 30

        ProgressBar:
            id: progress
            max: 5
            value: 1
            size_hint_y: None
            height: 10

        Label:
            id: timer
            text: "Time: 30"
            size_hint_y: None
            height: 30
            color: (1,1,1,1)

        BoxLayout:
            orientation: "vertical"
            padding: 20
            spacing: 15
            canvas.before:
                Color:
                    rgba: (0.95, 0.95, 0.95, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

            Label:
                id: question
                text: "Question"
                font_size: 18
                color: (0,0,0,1)

        Button:
            id: opt1
            background_color: (0.2, 0.6, 1, 1)
            on_press: root.check_answer(self.text)

        Button:
            id: opt2
            background_color: (0.2, 0.6, 1, 1)
            on_press: root.check_answer(self.text)

        Button:
            id: opt3
            background_color: (0.2, 0.6, 1, 1)
            on_press: root.check_answer(self.text)

        Button:
            id: opt4
            background_color: (0.2, 0.6, 1, 1)
            on_press: root.check_answer(self.text)

        Button:
            text: "Skip"
            size_hint_y: None
            height: 40
            on_press: root.skip_question()