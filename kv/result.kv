<ResultScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 40
        spacing: 20

        Label:
            id: result
            font_size: 28
            bold: True
            color: (1,1,1,1)

        Label:
            id: message
            text: ""
            color: (1,1,1,1)

        Label:
            id: history
            text: ""

        Button:
            text: "Retry Test"
            on_press: app.root.current = "test"

        Button:
            text: "Leaderboard"
            on_press: app.root.current = "leaderboard"

        Button:
            text: "Restart Test"
            on_press:
                app.root.current = "test"