<ResultScreen>:
    canvas.before:
        Color:
            rgba: (0.1, 0.1, 0.1, 1)  # Matching Deep Charcoal Background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [30, 50, 30, 30]
        spacing: 20

        # --- Performance Message ---
        Label:
            id: message
            text: "Excellent!"
            font_size: '32sp'
            bold: True
            color: (0.2, 0.6, 1, 1)  # Brand Blue
            size_hint_y: None
            height: 80

        # --- Score Card ---
        BoxLayout:
            orientation: "vertical"
            padding: 20
            spacing: 10
            size_hint_y: 0.4
            canvas.before:
                Color:
                    rgba: (0.15, 0.15, 0.15, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15,]
                Color:
                    rgba: (0.2, 0.6, 1, 1)
                Line:
                    width: 1.2
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 15)

            Label:
                id: result
                text: "Score: 0"
                font_size: '24sp'
                bold: True

            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: (0.3, 0.3, 0.3, 1)
                    Rectangle:
                        pos: [self.x + 20, self.y]
                        size: [self.width - 40, 1]

            Label:
                id: history
                text: "Top Scores: ..."
                halign: 'center'
                valign: 'top'
                text_size: self.width - 20, None
                line_height: 1.2

        # --- Navigation Section ---
        BoxLayout:
            orientation: "vertical"
            spacing: 12
            size_hint_y: None
            height: 180

            Button:
                text: "RETRY TEST"
                bold: True
                size_hint_y: None
                height: 55
                background_normal: ''
                background_color: (0, 0, 0, 0)
                on_release: app.root.current = "test"
                canvas.before:
                    Color:
                        rgba: (0.2, 0.6, 1, 1) if self.state == 'normal' else (0.1, 0.4, 0.8, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10,]

            Button:
                text: "LEADERBOARD"
                size_hint_y: None
                height: 50
                background_normal: ''
                background_color: (0, 0, 0, 0)
                on_release: app.root.current = "leaderboard"
                canvas.before:
                    Color:
                        rgba: (0.3, 0.3, 0.3, 1) if self.state == 'normal' else (0.2, 0.2, 0.2, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10,]

            Button:
                text: "BACK TO DASHBOARD"
                size_hint_y: None
                height: 50
                background_normal: ''
                background_color: (0, 0, 0, 0)
                on_release: app.root.current = "dashboard"
                canvas.before:
                    Color:
                        rgba: (0.2, 0.2, 0.2, 1) if self.state == 'normal' else (0.1, 0.1, 0.1, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10,]