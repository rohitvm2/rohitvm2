<LoginScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 40
        spacing: 20

        Label:
            text: "Mock Test App"
            font_size: 28
            bold: True

        TextInput:
            id: username
            hint_text: "Username"
            size_hint_y: None
            height: 50

        TextInput:
            id: password
            hint_text: "Password"
            password: True
            size_hint_y: None
            height: 50

        Button:
            text: "Login"
            size_hint_y: None
            height: 50
            background_color: (0.2,0.6,1,1)
            on_press: root.login()

        Button:
            text: "Register"
            size_hint_y: None
            height: 50
            background_color: (0.2,0.6,1,1)
            on_press: root.register()

        Label:
            id: message
            text: ""
            color: (1,1,1,1)